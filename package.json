{
  "name": "hostfall",
  "productName": "Hostfall",
  "private": true,
  "version": "0.0.2-beta.0",
  "type": "module",
  "main": ".vite/build/main.mjs",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.16.x"
  },
  "scripts": {
    "audit:independence": "node scripts/audit-independence.mjs",
    "audit:offline": "node scripts/audit-offline-runtime.mjs",
    "assets:inventory": "node scripts/runtime-asset-inventory.mjs --write",
    "assets:inventory:check": "node scripts/runtime-asset-inventory.mjs --check",
    "cards:sync": "node scripts/card-studio-data.mjs --write",
    "cards:data:check": "node scripts/card-studio-data.mjs --check",
    "cards:check": "node scripts/card-studio-data.mjs --check && node scripts/check-card-assets.mjs",
    "decks:lint": "node scripts/lint-decks.mjs",
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "electron:install": "install-electron",
    "electron:start": "electron-forge start",
    "electron:stage": "node scripts/generate-third-party-notices.mjs && node scripts/electron-release-assets.mjs --stage",
    "electron:package": "node scripts/generate-third-party-notices.mjs && node scripts/electron-release-assets.mjs --stage && electron-forge package --arch=x64 --platform=win32 && node scripts/electron-release-manifest.mjs --write",
    "electron:repro": "node scripts/generate-third-party-notices.mjs && node scripts/verify-electron-reproducibility.mjs",
    "electron:delta": "node scripts/electron-card-delta.mjs",
    "electron:release:audit": "node scripts/audit-electron-release.mjs",
    "electron:make": "node scripts/generate-third-party-notices.mjs && node scripts/electron-release-assets.mjs --stage && electron-forge make --arch=x64 --platform=win32",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "electron:security": "node --test scripts/run-electron-security-tests.mjs",
    "electron:verify": "node scripts/verify-electron-package.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite --config vite.config.ts build",
    "build:web": "tsc -b && vite --config vite.config.ts build",
    "test": "node --test scripts/run-engine-tests.mjs",
    "test:engine": "node --test scripts/run-engine-tests.mjs",
    "preview": "vite --config vite.config.ts preview --host 127.0.0.1"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "gsap": "3.12.2",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.128.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@electron/node-gyp": "github:electron/node-gyp#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "43.3.0",
    "playwright-core": "1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.110.0"
  }
}
